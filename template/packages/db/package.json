{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/cli-data-source.ts",
    "migrate": "tsx src/migrate.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/cli-data-source.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "1.1.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
