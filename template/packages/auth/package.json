{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed:dev": "tsx src/seed-dev.ts",
    "generate-schema": "pnpm dlx @better-auth/cli generate --config src/schema-generation.ts --output ../db/src/schema/auth.generated.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "better-auth": "^1.3.4",
    "drizzle-orm": "^0.44.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
