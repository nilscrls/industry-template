{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Internal packages compile to CJS so NestJS and Next.js share one
    // type identity for every dependency (drizzle, orpc, …).
    "verbatimModuleSyntax": false,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist"
  }
}
