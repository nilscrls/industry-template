import { Injectable } from "@nestjs/common";
import type {
  list{{ pascalCase plural }}QuerySchema,
  Paginated,
  {{ pascalCase name }},
} from "@repo/contracts";
import { {{ pascalCase name }} as {{ pascalCase name }}Entity } from "@repo/db";
import type { z } from "zod";
import { forbidden, notFound } from "../common/app-error";
import { currentUser } from "../common/request-context";
import { DbService } from "../db/db.module";
import { FgaService } from "../fga/fga.service";

type ListQuery = z.infer<typeof list{{ pascalCase plural }}QuerySchema>;
type Row = {{ pascalCase name }}Entity;

/**
 * Generated entity: user-scoped (owner-only capabilities in model.fga), no
 * RLS policy — a plain repository is enough. If it becomes tenant-shared,
 * add an organizationId column + RLS policy (see docs/database.md) and run
 * queries through dbService.tenant() instead of the repository directly.
 */
@Injectable()
export class {{ pascalCase plural }}Service {
  constructor(
    private readonly dbService: DbService,
    private readonly fga: FgaService
  ) {}

  private get repo() {
    return this.dbService.dataSource.getRepository({{ pascalCase name }}Entity);
  }

  async list(query: ListQuery): Promise<Paginated<{{ pascalCase name }}>> {
    // Owner-scoped: the model grants can_read to the owner only.
    const qb = this.repo
      .createQueryBuilder("row")
      .where("row.ownerId = :ownerId", { ownerId: currentUser().id });
    if (query.search) {
      qb.andWhere("row.name ILIKE :search", { search: `%${query.search}%` });
    }
    qb.orderBy(
      `row.${query.sortBy}`,
      query.sortOrder === "asc" ? "ASC" : "DESC"
    );
    const [rows, total] = await qb
      .skip((query.page - 1) * query.pageSize)
      .take(query.pageSize)
      .getManyAndCount();
    return {
      items: rows.map((row) => this.toDto(row)),
      total,
      page: query.page,
      pageSize: query.pageSize,
      totalPages: Math.ceil(total / query.pageSize),
    };
  }

  async find(id: string): Promise<{{ pascalCase name }}> {
    const row = await this.findRow(id);
    if (!(await this.can("can_read", row.id))) {
      throw forbidden("read", "{{ pascalCase name }}");
    }
    return this.toDto(row);
  }

  async create(input: { name: string }): Promise<{{ pascalCase name }}> {
    const me = currentUser();
    const row = await this.repo.save(
      this.repo.create({ name: input.name, ownerId: me.id })
    );
    // Tuple AFTER the DB commit (Postgres is the source of truth).
    await this.fga.writeTuples([
      {
        user: this.fga.ref.user(me.id),
        relation: "owner",
        object: this.ref(row.id),
      },
    ]);
    return this.toDto(row);
  }

  async update(input: {
    id: string;
    name?: string | undefined;
  }): Promise<{{ pascalCase name }}> {
    const row = await this.findRow(input.id);
    if (!(await this.can("can_update", row.id))) {
      throw forbidden("update", "{{ pascalCase name }}");
    }
    if (input.name !== undefined) {
      const result = await this.repo.update(
        { id: row.id },
        { name: input.name }
      );
      // A row can vanish between findRow and the update racing a delete.
      if (result.affected !== 1) {
        throw notFound("{{ pascalCase name }}");
      }
      row.name = input.name;
    }
    return this.toDto(row);
  }

  async remove(id: string): Promise<{ id: string }> {
    const row = await this.findRow(id);
    if (!(await this.can("can_delete", row.id))) {
      throw forbidden("delete", "{{ pascalCase name }}");
    }
    await this.repo.delete({ id });
    await this.fga.deleteObjectTuples(this.ref(id));
    return { id };
  }

  private ref(id: string): string {
    return `{{ snakeCase name }}:${id}`;
  }

  private can(relation: string, id: string): Promise<boolean> {
    return this.fga.check(this.fga.me(), relation, this.ref(id));
  }

  private async findRow(id: string): Promise<Row> {
    const row = await this.repo.findOneBy({ id });
    if (!row) {
      throw notFound("{{ pascalCase name }}");
    }
    return row;
  }

  private toDto(row: Row): {{ pascalCase name }} {
    return {
      id: row.id,
      name: row.name,
      ownerId: row.ownerId,
      createdAt: row.createdAt.toISOString(),
      updatedAt: row.updatedAt.toISOString(),
    };
  }
}
