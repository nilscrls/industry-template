{
  "$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!packages/db/drizzle/**",
      "!apps/web/src/components/ui/**" // generated by the shadcn CLI
    ]
  }
}
