{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/nestjs",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "javascript": {
    "parser": {
      // NestJS constructor injection uses parameter decorators.
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/**", "packages/**"],
      "linter": {
        "rules": {
          // React-only rules misfire on express `app.use` / Nest patterns.
          "correctness": { "useHookAtTopLevel": "off" },
          // Nest resolves constructor DI from emitDecoratorMetadata — an
          // `import type` of an injected class erases it and breaks DI at
          // runtime, so imports must stay value imports here.
          "style": { "useImportType": "off" },
          // DI-only constructors are idiomatic NestJS.
          "suspicious": { "noEmptyBlockStatements": "off" }
        }
      }
    },
    {
      "includes": [
        "turbo/generators/**",
        "**/e2e/**",
        "**/test/**",
        "**/*.test.ts",
        "**/*.spec.ts"
      ],
      "linter": {
        // Inline regexes are fine in tests and one-shot generator configs.
        "rules": { "performance": { "useTopLevelRegex": "off" } }
      }
    },
    {
      // tsconfig presets are JSONC by TypeScript convention.
      "includes": ["packages/typescript-config/*.json"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      // A package's index.ts IS its public API; drizzle needs a combined
      // schema module for relational queries.
      "includes": [
        "packages/*/src/index.ts",
        "packages/db/src/schema/index.ts"
      ],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      // `import * as schema` is how drizzle/better-auth consume a schema.
      "includes": ["packages/db/src/client.ts", "packages/auth/src/auth.ts"],
      "linter": { "rules": { "performance": { "noNamespaceImport": "off" } } }
    },
    {
      // "${userId}" is our permission-condition placeholder DSL, not a
      // botched template literal.
      "includes": [
        "packages/contracts/src/permissions.ts",
        "packages/auth/src/ability.ts",
        "packages/auth/src/ability.test.ts"
      ],
      "linter": {
        "rules": { "suspicious": { "noTemplateCurlyInString": "off" } }
      }
    }
  ],
  "vcs": {
    // The template ships its gitignore as `_gitignore` (npm strips dotfiles),
    // so the ignore file only exists after scaffolding.
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!packages/db/drizzle",
      "!apps/web/src/components/ui" // generated by the shadcn CLI
    ]
  }
}
