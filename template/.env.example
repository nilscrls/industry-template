# NOTE: NODE_ENV deliberately does NOT live here. The runtime owns it:
# `next build`/`next dev` set it themselves (a forced value breaks the build),
# compose sets `production` for containers, tests set `test`, and the api
# defaults to `development` when it is absent.

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# JSON logs always go to stdout (12-factor). Enable the rotating file
# transport only for VM deployments without a log collector.
LOG_FILE_ENABLED=false
LOG_DIR=./logs

# ─── URLs / ports ───────────────────────────────────────────────────────────
API_PORT=3001
# Server-to-server URL of the API (Next.js SSR, e2e). Inside docker: http://api:3001
API_URL=http://localhost:3001
# Public origin of the web app — also Better-Auth's trusted origin
WEB_URL=http://localhost:3000
# What the browser calls. Same-origin via the Next.js /api rewrite — no CORS.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generated by create-industry-app; rotate per environment.
BETTER_AUTH_SECRET=

# ─── Datastores ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ─── Object storage (Minio locally, any S3 in prod) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
# Endpoint reachable by the BROWSER for presigned URLs (differs from
# S3_ENDPOINT when the API talks to minio over the docker network).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads

# ─── Mail (maildev locally: UI on http://localhost:1080) ────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Industry App <no-reply@example.com>

# ─── Used by docker-compose*.yml only ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
