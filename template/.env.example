# Every variable the apps read is declared here — none have in-code defaults.
# A missing variable fails fast at startup/build instead of silently falling
# back, so this file is the complete, explicit inventory of the configuration.
#
# NOTE: NODE_ENV deliberately does NOT live here. The runtime owns it:
# `next build`/`next dev` set it themselves (a forced value breaks the build),
# compose sets `production` for containers, tests set `test`, and the api
# defaults to `development` when it is absent (the sole in-code default).

# ─── Observability ──────────────────────────────────────────────────────────
# Traces export over OTLP/HTTP when enabled — any collector, no vendor baked
# in. `docker compose --profile otel up` runs a local sink for development.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=api

# Sentry exception capture (api). The web app has its own NEXT_PUBLIC_ pair.
SENTRY_ENABLED=false
SENTRY_DSN=replace-with-sentry-dsn

# PostHog: exception capture + feature flags (api server key).
POSTHOG_ENABLED=false
POSTHOG_API_KEY=replace-with-posthog-project-api-key
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry + PostHog in the browser. NEXT_PUBLIC_* values are baked into the
# web build (compose forwards them as Docker build args).
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=replace-with-sentry-dsn
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=replace-with-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# JSON logs always go to stdout (12-factor). Enable the rotating file
# transport only for VM deployments without a log collector.
LOG_FILE_ENABLED=false
LOG_DIR=./logs

# ─── URLs / ports ───────────────────────────────────────────────────────────
API_PORT=3001
# Server-to-server URL of the API (Next.js SSR, e2e). Inside docker: http://api:3001
API_URL=http://localhost:3001
# Public origin of the web app — also Better-Auth's trusted origin
WEB_URL=http://localhost:3000
# What the browser calls. Same-origin via the Next.js /api rewrite — no CORS.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generated by create-industry-app; rotate per environment.
BETTER_AUTH_SECRET=

# Microsoft Entra ID SSO (OIDC). Register an app in Entra with redirect URL
# <WEB_URL>/api/auth/callback/microsoft. The placeholders keep local sign-in
# working; the Microsoft button errors until real values are set.
MICROSOFT_CLIENT_ID=replace-with-entra-application-id
MICROSOFT_CLIENT_SECRET=replace-with-entra-client-secret
# Directory (tenant) id, or `common` to accept any Entra tenant.
MICROSOFT_TENANT_ID=common

# ─── Datastores ─────────────────────────────────────────────────────────────
# Three DB principals (created by packages/db/sql/init-roles.sh on first
# postgres boot + the grants migration):
#   app_user  — API runtime, subject to row-level security
#   app_auth  — Better-Auth only, BYPASSRLS (reads member pre-tenant)
#   postgres  — owner: migrations and seeds (bypasses RLS as owner)
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/app
DATABASE_URL_AUTH=postgresql://app_auth:app_auth@localhost:5432/app
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ─── Object storage (Minio locally, any S3 in prod) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
# Endpoint reachable by the BROWSER for presigned URLs (differs from
# S3_ENDPOINT when the API talks to minio over the docker network).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads

# ─── Mail (maildev locally: UI on http://localhost:1080) ────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Industry App <no-reply@example.com>

# ─── Used by docker-compose*.yml only ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Passwords for the RLS roles, consumed by packages/db/sql/init-roles.sh on
# the FIRST postgres boot (recreate the volume after changing them).
APP_USER_PASSWORD=app_user
APP_AUTH_PASSWORD=app_auth
